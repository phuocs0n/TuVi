# Sao chép thành .env rồi điền giá trị thật:  cp .env.example .env
# File .env đã nằm trong .gitignore — tuyệt đối không commit.

# ---------- Chung ----------
APP_ENV=development
APP_DOMAIN=tuviai.id.vn
API_PUBLIC_URL=http://localhost:8000
NEXT_PUBLIC_API_URL=http://localhost:8000

# ---------- Database ----------
POSTGRES_USER=tuvi
POSTGRES_PASSWORD=change-me
POSTGRES_DB=tuvi
DATABASE_URL=postgresql://tuvi:change-me@postgres:5432/tuvi
REDIS_URL=redis://redis:6379/0

# ---------- Auth ----------
JWT_SECRET=change-me-to-a-long-random-string

# ---------- AI Engine ----------
AI_ENGINE_URL=http://ai-engine:8001
LLM_PROVIDER=anthropic
LLM_MODEL=claude-sonnet-5-5
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# ---------- Thanh toán ----------
PAYOS_CLIENT_ID=
PAYOS_API_KEY=
PAYOS_CHECKSUM_KEY=
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
MOMO_PARTNER_CODE=
MOMO_ACCESS_KEY=
MOMO_SECRET_KEY=
